---
import BaseLayout from '../layouts/BaseLayout.astro';
import YearsSince from '../components/YearsSince.jsx';
---
<BaseLayout title="Aleksander Adamowski - Resume">
  <div>
    <h1 style="font-size: 3.5em;">My Resume</h1>

    <h1 class="resume-section">Experience</h1>

    <h2 class="resume-company">
      <a href="https://www.facebook.com/" target="_blank" rel="noopener" class="ext-link">Facebook, Inc.</a>
    </h2>

    <h4 class="resume-period">
      March 2016 - Now (<YearsSince startDate="2016-03-01T09:00:00-07:00" client:load /> years)
    </h4>
    <h3 class="resume-position">
      <a href="https://engineering.fb.com/category/production-engineering/" target="_blank" rel="noopener">Production Engineer</a>
    </h3>
    <q>
      Production Engineering at Facebook is a hybrid between software and
      systems engineering; it keeps Facebook running smoothly and scaling
      efficiently. The Production Engineering team works within Facebook’s
      product and infrastructure teams to make sure our services are
      reliable and scalable. The team writes code and debugs hard problems
      in live production that impact more than 2 billion people around the
      world.
    </q>
    <p> </p>

    <h4 class="resume-period">Oct 2014 - Feb 2016 (1.5 years)</h4>
    <h3 class="resume-position">
      <a href="https://engineering.fb.com/category/security/" target="_blank" rel="noopener">Security Engineer</a>
    </h3>
    <q>
      Facebook Security strives to create and maintain the safest
      environment possible for people on Facebook. We are building the
      technologies that lay the groundwork for more than 2 billion people
      around the world to connect and share with each other safely.
    </q>
    <p> </p>

    <h2 class="resume-company">
      <a href="https://www.pzu.pl/" target="_blank" rel="noopener" class="ext-link">Grupa PZU</a>
    </h2>

    <h4 class="resume-period">Oct 2010 - Sep 2014 (4 years)</h4>
    <h3 class="resume-position">
      <a href="http://en.wikipedia.org/wiki/Systems_architect" target="_blank" rel="noopener">Systems Architect</a>
    </h3>

    <ul>
      <li>Defined architecture and requirements for information systems</li>
      <li>
        Provided technical expertise during negotiations with external
        software houses
      </li>
      <li>Implemented key pieces of systems</li>
      <li>Defined internal technology standards</li>
    </ul>

    <h2 class="resume-company">
      <a href="https://www.fiserv.com/en-pl/" target="_blank" rel="noopener" class="ext-link">First Data Polska S.A.</a>
    </h2>

    <h4 class="resume-period">Sep 2008 - Nov 2010 (2 years)</h4>
    <h3 class="resume-position">Senior Application Developer</h3>
    <p>Design and development of card payments processing applications.</p>

  </div>

  <h1 class="resume-section">Education</h1>

  <h2 class="resume-company">
    <a href="https://www.pja.edu.pl" target="_blank" rel="noopener" class="ext-link">Polish-Japanese Academy of Information Technology</a>
  </h2>

  <h3 class="resume-diploma">
    Master of Computer Science, Systems and Network Programming
  </h3>

  <h3 class="resume-diploma">
    Graduate Engineer (Bachelor's), Systems and Network Programming
  </h3>

</BaseLayout>
