---
// Target main content instead of just article
const { frontmatter } = Astro.props;
// Default heading depth is 3 (h1-h3), can be overridden in frontmatter
const headingDepth = frontmatter?.tocDepth ?? 3;
// Optional: completely disable TOC
const showToc = frontmatter?.toc ?? true;

if (!showToc) {
  return null;
}
---
{showToc && (
  <>
    <div class="toc-container" id="toc-container" style="
      position: fixed;
      left: calc(67%);
      top: 15%;
      max-height: 70vh;
      max-width: 30em;
      background-color: var(--color-bg);
      color: var(--color-text);
      border: 1px solid var(--color-border);
      border-radius: 4px;
      padding: 1rem;
      margin: 0;
      z-index: 1000;
      font-family: var(--font-heading);
      font-weight: 600;
    ">
      <button
        id="toc-hide-btn"
        class="toc-hide-btn"
        type="button"
        aria-label="Hide table of contents"
        title="Hide table of contents"
      >
        »
      </button>
      <div style="
        overflow: hidden;
        overflow-y: auto;
        margin-bottom: 0.5rem;
      ">
        <h2 style="
          margin: 0 0 0.5rem 0;
          font-size: 1.1em;
          color: var(--color-heading);
          border-bottom: 1px solid var(--color-border);
          padding-bottom: 0.25rem;
        ">
          Table of Contents
        </h2>

        <!-- Client-side TOC generation -->
        <div id="toc-content" style="
          font-size: 0.9em;
          line-height: 1.5;
        " data-heading-depth={headingDepth}>
          <!-- Will be populated by script -->
        </div>
      </div>
    </div>

    <!-- Shown only while the TOC is hidden: a compact tab on the screen's
         right edge (same vertical anchor as the TOC). 44px tall so it stays
         an easy touch target on mobile without covering more than a sliver
         of the content column. -->
    <button
      id="toc-unhide-btn"
      class="toc-unhide-btn"
      type="button"
      style="display: none;"
      aria-label="Show table of contents"
      title="Show table of contents"
    >
      TOC
    </button>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        const tocContainer = document.getElementById('toc-content');
        if (!tocContainer) return;

        // Get heading depth from data attribute
        const headingDepth = parseInt(tocContainer.getAttribute('data-heading-depth')) || 3;

        // Get all headings from ARTICLE content (where the actual note content lives)
        // Exclude headings inside header, nav, footer, and TOC container itself
        const allHeadings = document.querySelectorAll('article h1, article h2, article h3, article h4, article h5, article h6');
        const headings = Array.from(allHeadings).filter(heading => {
          return !heading.closest('.toc-container') && 
                 !heading.closest('header') && 
                 !heading.closest('nav') && 
                 !heading.closest('footer');
        });

        if (headings.length === 0) {
          tocContainer.innerHTML = `<p style="color: var(--color-muted); font-style: italic;">No sections found. Total headings in article: ${allHeadings.length}</p>`;
          return;
        }

        // Create the TOC list
        const tocList = document.createElement('ul');
        tocList.style.listStyle = 'none';
        tocList.style.paddingLeft = '1rem';
        tocList.style.margin = '0';

        headings.forEach(heading => {
          // Get heading level (1-6)
          const level = parseInt(heading.tagName.substring(1));

          // Skip if beyond our configured depth
          if (level > headingDepth) return;

          // Skip the first h1 if it's the page title (to avoid duplication)
          const isFirstH1 = heading === document.querySelector('article h1');
          const pageTitle = document.title.replace('Aleksander Adamowski - ', '');
          const isPageTitle = isFirstH1 && heading.textContent.trim() === pageTitle;
          if (isFirstH1 && isPageTitle) return;

          const listItem = document.createElement('li');
          listItem.style.marginBottom = '0.25rem';

          const link = document.createElement('a');
          link.href = '#' + heading.id;
          link.textContent = heading.textContent;
          link.style.textDecoration = 'none';
          link.style.color = 'var(--color-text)';
          link.style.display = 'block';

          // Add indentation based on heading level
          const indent = (level - 1) * 1; // 1rem per level
          listItem.style.textIndent = indent + 'rem';

          // Hover effects to match site style
          link.addEventListener('mouseenter', function() {
            link.style.textDecoration = 'underline';
          });
          link.addEventListener('mouseleave', function() {
            link.style.textDecoration = 'none';
          });

          listItem.appendChild(link);
          tocList.appendChild(listItem);
        });

        tocContainer.appendChild(tocList);

        // Add smooth scroll behavior for internal links
        document.querySelectorAll('a[href^="#"]').forEach(function(anchor) {
          anchor.addEventListener('click', function(e) {
            e.preventDefault();
            const target = document.querySelector(this.getAttribute('href'));
            if (target) {
              target.scrollIntoView({
                behavior: 'smooth'
              });
            }
          });
        });
      });
    </script>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function() {
        var toc = document.getElementById('toc-container');
        var hideBtn = document.getElementById('toc-hide-btn');
        var showBtn = document.getElementById('toc-unhide-btn');
        if (!toc || !hideBtn || !showBtn) return;

        hideBtn.addEventListener('click', function() {
          toc.style.display = 'none';
          showBtn.style.display = 'inline-flex';
          if (showBtn.focus) showBtn.focus();
        });

        showBtn.addEventListener('click', function() {
          toc.style.display = '';
          showBtn.style.display = 'none';
          if (hideBtn.focus) hideBtn.focus();
        });
      });
    </script>

    <style>
      /* Hide button: sits in the TOC's top-right corner, next to the header */
      .toc-hide-btn {
        position: absolute;
        top: 0.4rem;
        right: 0.4rem;
        width: 2rem;
        height: 2rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        background: none;
        border: none;
        border-radius: 4px;
        color: var(--color-muted);
        font-size: 1.3rem;
        line-height: 1;
        font-family: var(--font-heading);
        cursor: pointer;
      }

      .toc-hide-btn:hover {
        color: var(--color-text);
        background: var(--color-code-bg);
      }

      /* Unhide tab: compact, pinned to the right edge at the TOC's old
         vertical position. 44px tall = comfortable touch target. */
      .toc-unhide-btn {
        position: fixed;
        top: 15%;
        right: 0;
        z-index: 1000;
        min-width: 44px;
        min-height: 44px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 0.5rem;
        background: var(--color-bg);
        color: var(--color-muted);
        border: 1px solid var(--color-border);
        border-right: none;
        border-radius: 6px 0 0 6px;
        font-family: var(--font-heading);
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.03em;
        cursor: pointer;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.15);
      }

      .toc-unhide-btn:hover {
        color: var(--color-text);
      }
    </style>
  </>
)}
